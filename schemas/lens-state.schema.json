{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasmind.dev/schemas/lens-state.schema.json",
  "title": "AtlasMind Lens state-machine declarations",
  "description": "Explicit lifecycle states and transitions visualized by AtlasMind Lens without executing project code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machines"],
  "properties": {
    "version": { "const": 1 },
    "machines": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/machine" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspacePath"],
      "properties": {
        "workspacePath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startLine", "startColumn", "endLine", "endColumn"],
          "properties": {
            "startLine": { "type": "integer", "minimum": 1 },
            "startColumn": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 },
            "endColumn": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "terminal": { "type": "boolean", "default": false },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "from": { "type": "string", "minLength": 1, "maxLength": 200 },
        "to": { "type": "string", "minLength": 1, "maxLength": 200 },
        "event": { "type": "string", "minLength": 1, "maxLength": 200 },
        "guard": { "type": "string", "minLength": 1, "maxLength": 300 },
        "effect": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "initial", "states", "transitions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "initial": { "type": "string", "minLength": 1, "maxLength": 200 },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": { "$ref": "#/$defs/state" }
        },
        "transitions": {
          "type": "array",
          "maxItems": 300,
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    }
  }
}
