out/
node_modules/
*.vsix
.vscode-test/
coverage/
.stryker-tmp/
# Written by every `vitest run` so the Testing dashboard has a verdict to read.
# Local evidence of a local run — never committed, or the dashboard would report
# whoever last pushed rather than the state of this working copy.
test-results/
.claude/
# project_memory: track curated SSOT (the shared "project brain"), but keep
# volatile / potentially-sensitive content out of this PUBLIC repo.
project_memory_old/
project_memory/sessions/
project_memory/temp/
project_memory/operations/project-run-*.json
project_memory/operations/.delivery-lock.json
.atlasmind/

# A separate project that happens to live inside this working copy. It carries
# its own .git, so `git add -A` staged it as a gitlink with no .gitmodules
# entry — which every `actions/checkout` then failed on before any job could
# run ("No url found for submodule path 'website'"). Ignored rather than
# declared as a submodule: it is not part of this repository.
website/
