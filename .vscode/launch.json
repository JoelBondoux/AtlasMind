{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--disable-extension",
        "GitHub.copilot-chat",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "experimentalNetworking": "off",
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build-extension"
    },
    {
      "name": "Run Extension (Copilot integration)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "experimentalNetworking": "off",
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build-extension"
    }
  ]
}
